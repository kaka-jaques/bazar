# Copy this file to .env and fill in your server-side InfinitePay credentials.
INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=
INFINITEPAY_REDIRECT_URL=http://localhost:4200/pagamento/retorno

# SQLite creates this database and its tables automatically on first API startup.
DB_PATH=./server/data/reservations.local.sqlite

# Optional key for manual reservation updates; not needed by checkout.
RESERVATION_ADMIN_KEY=
